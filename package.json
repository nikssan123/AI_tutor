{
  "name": "meritkeep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "admin:grant": "tsx scripts/admin-grant.ts",
    "console:role": "tsx scripts/console-role.ts",
    "brand:build": "tsx scripts/build-brand.ts",
    "build": "next build",
    "coverage": "vitest run --coverage",
    "coverage:audit": "tsx scripts/coverage-audit.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "inngest:dev": "inngest-cli dev",
    "lint": "eslint .",
    "guides:sources": "tsx scripts/guides-sources.ts",
    "audiences:validate": "tsx scripts/audiences-validate.ts",
    "guides:validate": "tsx scripts/guides-validate.ts",
    "packs:seed": "tsx scripts/packs-seed.ts",
    "packs:validate": "tsx scripts/packs-validate.ts",
    "calibrate": "tsx scripts/calibration.ts",
    "review:sheet": "tsx scripts/pack-review-sheet.ts",
    "actions:audit": "tsx scripts/server-actions-audit.ts",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm tokens:check && pnpm coverage:audit && pnpm actions:audit && pnpm packs:validate && pnpm guides:validate && pnpm audiences:validate && pnpm coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-toggle-group": "1.1.19",
    "better-auth": "1.6.27",
    "drizzle-orm": "0.45.2",
    "inngest": "4.18.0",
    "next": "16.3.0",
    "postgres": "3.4.9",
    "posthog-js": "^1.417.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "inngest-cli",
      "protobufjs",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "inngest-cli": "1.41.1",
    "jsdom": "^30.0.1",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
