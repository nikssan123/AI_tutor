node_modules/
.next/
out/
build/
dist/

.env
.env.local
.env*.local
# The production env file lives at /srv/meritkeep/.env.prod on the VPS, inside
# this same checkout. This repo is public, so without these two lines a stray
# `git add -A` on that box stages the Postgres password, the auth secret and
# four API keys. The trailing-glob rule also covers editor swap files, which
# hold the same plaintext.
.env.prod
.env.prod.*

# The SSH target `./deploy.sh` talks to. Same reasoning as the orange cloud and
# the `production` environment secrets: this repo is public and that host also
# fronts webwork.bg's customer domains, so its address stays out of the source.
deploy/.env.deploy

*.tsbuildinfo
next-env.d.ts

.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

coverage/
.vitest/

# Inngest dev server state
.inngest/

# Pack review sheets are generated working documents — you tick through them.
# `pnpm review:sheet` regenerates; committing them would mean merge conflicts
# over checkboxes. The calibration corpus is NOT ignored: it is Phase-0 data
# and §27 asks for it to run in CI.
review/
