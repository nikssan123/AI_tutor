# Copy to .env.local. Everything needed for this pass is local — no accounts.

# --- Database (E1) ---
# Local: `docker compose up -d` then use the URL below.
# Production: swap for a Neon connection string; nothing else changes.
DATABASE_URL=postgres://online_uni:online_uni@localhost:5433/online_uni

# The role /admin/sql reads through. Optional but strongly recommended: it is a
# non-superuser with column-level grants, so credential columns are refused by
# Postgres rather than merely hidden by the app, and `user.role` is not
# writable — which keeps `pnpm admin:grant` the only way to become an admin.
#
# Generate it with `pnpm console:role --apply`, then paste the URL it prints
# here. Add --allow-writes if the console's write mode should function at all.
# Re-run it after any migration that adds a table.
#
# Left unset, the console falls back to DATABASE_URL and says so in a banner.
CONSOLE_DATABASE_URL=

# --- Auth (E1) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The origin auth links are built against. Falls back to NEXT_PUBLIC_SITE_URL,
# then to localhost. It ends up inside emails that cannot be edited after
# sending, so set it in production.
BETTER_AUTH_URL=http://localhost:3000

# The canonical site origin (§13.3). Also the fallback for BETTER_AUTH_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in. Both halves or neither: with only one set, the provider is
# not registered at all, and the sign-in screen simply doesn't offer Google.
# Authorised redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (§18.1 — verification, password reset, email change) ---
# Unset, every message is printed to the server console instead of being sent,
# link included — so all three flows are usable locally with no account.
# Set RESEND_API_KEY and you MUST set EMAIL_FROM to an address on a domain
# verified with Resend, or every send is rejected.
RESEND_API_KEY=
EMAIL_FROM="online_uni <hello@example.com>"

# --- AI (required from E3 onward; unused in this pass) ---
# Model routing per §14.8: haiku -> sonnet -> opus. Never default everything to Opus.
ANTHROPIC_API_KEY=

# --- Background jobs (E1) ---
# Local dev needs neither key; INNGEST_DEV=1 puts the SDK in dev mode so it
# talks to `pnpm inngest:dev` instead of refusing to serve without a signing key.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Observability (§14.8, §25) ---
# All three no-op when unset, so nothing here blocks local development.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
